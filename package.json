{
	"name": "intx",
	"version": "0.1.0",
	"description": "Ultra high-performance multi-word integer arithmetic in pure JavaScript",
	"type": "commonjs",
	"main": "src/index.js",
	"engines": {
		"node": ">=20.0.0"
	},
	"exports": {
		".": "./src/index.js",
		"./*": "./src/*"
	},
	"scripts": {
		"test": "node --test 'src/**/test.js' 'src/**/*.test.js'",
		"i32:showdown": "node src/i32/showdown.js",
		"i32:add:showdown": "node src/i32/add/showdown.js",
		"i32:mul:showdown": "node src/i32/mul/showdown.js",
		"u32:mul:bench": "node src/u32/mul/bench.js",
		"u32:mulhi:showdown": "node src/u32/mulhi/candidates/showdown.js",
		"u32:mulwide:showdown": "node src/u32/mulwide/candidates/showdown.js"
	},
	"imports": {
		"#*": "./src/*/index.js"
	},
	"files": [
		"src/",
		"!**/candidates/**",
		"!**/bench/**",
		"!**/bench.js",
		"!**/microbe/**",
		"!**/test/**",
		"!**/*.test.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/impawstarlight/intx.git"
	},
	"author": {
		"name": "Abdul Kaium",
		"url": "https://github.com/impawstarlight"
	},
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/impawstarlight/intx/issues"
	},
	"homepage": "https://github.com/impawstarlight/intx#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@stdlib/muldw-cjs": "github:stdlib-js/number-uint32-base-muldw"
	}
}
